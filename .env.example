# Copy to `.env` at the repo root — docker compose reads it automatically.
#   cp .env.example .env

# --- Postgres (shared by the Go and Python services) ---
POSTGRES_USER=patchforge
POSTGRES_PASSWORD=patchforge
POSTGRES_DB=patchforge
POSTGRES_PORT=5432

# --- Go core service ---
CORE_PORT=8080
SECRET_KEY=change-me-jwt-signing-key
HASH_KEY=change-me-token-encryption-key
GITHUB_SECRET=your-github-webhook-secret
WEBHOOK_URL=https://your-ngrok-domain.example/webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GIN_MODE=release

# --- Python insights service ---
INSIGHTS_PORT=50051
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2
MAX_TOKENS=1500
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080
VITE_APP_GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
